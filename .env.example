# ---------------------------------------------------------------------------
# Tripura Explore - example environment file
# Copy this file to `.env` and replace the placeholder values.
# `.env` is ignored by git. Never commit real secrets.
# ---------------------------------------------------------------------------

# Required: a long random string used to sign session cookies and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-hex-string

# Optional: overrides the default SQLite file inside the instance/ folder.
# Example for PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/tripura_explore
# DATABASE_URL=sqlite:///instance/tripura_explore.db

# Optional: create the first administrator when running `flask seed-data --with-admin`.
# If ADMIN_PASSWORD is empty, use `flask create-admin` to set a password interactively.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# OpenStreetMap local-experience discovery uses Nominatim and Overpass without API keys.
# Replace the example contact and URL before deploying. Nominatim public service does not support autocomplete.
OSM_USER_AGENT=TripuraExplorer/1.0 (contact: admin@example.com)
APPLICATION_URL=https://example.com
OSM_GEOCODER_TIMEOUT=8
OSM_OVERPASS_TIMEOUT=18
# Optional compatible service endpoints for self-hosted or licensed providers.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: production hardening
# COOKIE_SECURE=true
# SESSION_LIFETIME_MINUTES=120
# LOG_LEVEL=WARNING
